{
  "name": "@local/dsh-openai-web-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sign in with ChatGPT for the existing DSH Codex provider.",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "auth.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "scripts": { "test": "node --test tests/*.test.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings-models"]
    }
  }
}
